rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdventureMember(adventureId) {
      return request.auth != null &&
        firestore.exists(
          /databases/(default)/documents/adventures/$(adventureId)/members/$(request.auth.uid)
        );
    }

    match /adventures/{adventureId}/memories/{memoryId}/{mediaId} {
      allow read:
        if isAdventureMember(adventureId);

      allow create:
        if isAdventureMember(adventureId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'image/.*'
        );

      allow update:
        if false;

      allow delete:
        if isAdventureMember(adventureId);
    }
  }
}
